{
  "name": "chart-lib",
  "version": "0.1.0",
  "description": "Dynamic visualization component library for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist/types",
    "test": "bun test src/__tests__",
    "test:watch": "bun test --watch src/__tests__",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "plotly.js": "^2.35.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-plotly.js": "^2.6.0"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/plotly.js": "^2.33.4",
    "@types/react-plotly.js": "^2.6.3",
    "plotly.js": "^2.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "vite-plugin-dts": "^4.0.3"
  }
}
